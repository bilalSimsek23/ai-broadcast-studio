APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI text generation (config/ai.php -> ai.text) ---------------------------
# Which driver backs the logical text providers (default | fast | host_rebuttal).
# Leave unset for the deterministic, network-free fake driver (local/CI/tests).
# Set to "openai" to route those logical keys through the real OpenAI adapter.
AI_TEXT_DRIVER=fake
# Concrete vendor model id per logical model key. Only used when AI_TEXT_DRIVER
# is a real vendor (e.g. gpt-5.6-sol). Fake vendor ids are the fallback.
AI_TEXT_MODEL_DEFAULT=fake-balanced-v1
AI_TEXT_MODEL_SMALL=fake-small-v1
AI_TEXT_MODEL_LARGE=fake-large-v1
AI_TEXT_MODEL_HOST_REBUTTAL=fake-rebuttal-v1

# OpenAI adapter credentials/transport (read only in config/ai.php, never
# persisted, never logged). Required when AI_TEXT_DRIVER=openai. The adapter
# targets the Responses API (POST {OPENAI_BASE_URL}/responses).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_TIMEOUT=30
OPENAI_TEXT_CONNECT_TIMEOUT=10
# Forward the neutral `temperature` to OpenAI. GPT-5.x reasoning models only
# accept the default temperature and 400 (unsupported_value) otherwise, so
# leave this false for that family; set true only for a GPT-4-class model.
OPENAI_TEXT_SEND_SAMPLING=false

# --- Studio live realtime voice (config/ai.php -> ai.realtime) --------------
# Driver for the /studio/live voice prototype: unset/"fake" = offline stub
# (local/CI/tests), "openai" = real OpenAI Realtime API over WebRTC.
AI_REALTIME_DRIVER=fake
# Session length (seconds) — the single source of truth; the browser reads it
# from the backend. Default 1200 (20 min); raise to 1800–2400 for longer
# broadcast rehearsals. Clamped to [30, 3600].
STUDIO_LIVE_MAX_SECONDS=1200
# Optional: override the AI's standing Turkish studio brief without a deploy.
STUDIO_LIVE_INSTRUCTIONS=
# OpenAI Realtime (reuses OPENAI_API_KEY / OPENAI_BASE_URL). Required when
# AI_REALTIME_DRIVER=openai. The key is minted into a short-lived ephemeral
# client secret by the backend and is never sent to the browser.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TIMEOUT=15
OPENAI_REALTIME_CONNECT_TIMEOUT=10
# Where the browser POSTs its WebRTC SDP offer (Bearer = the ephemeral secret).
OPENAI_REALTIME_WEBRTC_URL=https://api.openai.com/v1/realtime/calls
# Studio-room audio handling (config/ai.php -> ai.realtime.audio). getUserMedia
# constraints handed to the browser:
STUDIO_LIVE_ECHO_CANCELLATION=true
STUDIO_LIVE_NOISE_SUPPRESSION=true
STUDIO_LIVE_AUTO_GAIN=true
# OpenAI Realtime input tuning for a noisy room. noise_reduction: near_field |
# far_field | off. The VAD values are a MILD raise of the defaults — do NOT
# turn this into a hard gate that clips the start of real speech.
STUDIO_LIVE_NOISE_REDUCTION=far_field
STUDIO_LIVE_VAD_THRESHOLD=0.6
STUDIO_LIVE_VAD_PREFIX_MS=300
STUDIO_LIVE_VAD_SILENCE_MS=500
